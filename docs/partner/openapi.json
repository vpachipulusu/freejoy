{
  "openapi": "3.1.0",
  "info": {
    "title": "Freejoy Partner API",
    "version": "1.0.0"
  },
  "paths": {
    "/partner/v1/me": {
      "get": {
        "summary": "Who this key belongs to",
        "description": "The merchant the key was issued to and the key's label. It changes nothing; it proves the whole path.",
        "operationId": "partner-me",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown, revoked or malformed key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable (the database or a limiter)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "PartnerKey": []
          }
        ]
      }
    },
    "/partner/v1/offers/{ref}": {
      "put": {
        "tags": [
          "offers"
        ],
        "summary": "Create or update an offer submission",
        "description": "Send the whole offer. It is stored as a **draft** for an editor to review: nothing you send is ever published\nby the API. The same body twice changes nothing. ``outcome`` says what happened: ``created``; ``refreshed``\n(an editor had not touched the draft yet, so it took the new content); ``pending_update`` (an editor has edited,\npublished or ended the offer, so the new content waits for an editor and the published page is unchanged);\n``unchanged``.",
        "operationId": "partner-offers-put",
        "security": [
          {
            "PartnerKey": []
          }
        ],
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$",
              "description": "Your own id for the offer: 1 to 64 letters, digits, dots, underscores or hyphens.",
              "title": "Ref"
            },
            "description": "Your own id for the offer: 1 to 64 letters, digits, dots, underscores or hyphens."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OfferSubmission"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionResultResponse"
                }
              }
            }
          },
          "422": {
            "description": "A value the rules refuse",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodedErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown, revoked or malformed key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests or too many submissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodedErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable (the database or a limiter)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No offer with this ref",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The offer was archived by an editor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodedErrorResponse"
                }
              }
            }
          },
          "201": {
            "description": "A new submission was created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionResultResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "offers"
        ],
        "summary": "Read one submission",
        "operationId": "partner-offers-get",
        "security": [
          {
            "PartnerKey": []
          }
        ],
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$",
              "description": "Your own id for the offer: 1 to 64 letters, digits, dots, underscores or hyphens.",
              "title": "Ref"
            },
            "description": "Your own id for the offer: 1 to 64 letters, digits, dots, underscores or hyphens."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown, revoked or malformed key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable (the database or a limiter)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No offer with this ref",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/partner/v1/offers": {
      "get": {
        "tags": [
          "offers"
        ],
        "summary": "List your submissions",
        "description": "Your submissions, newest first: status, the public page when live, and whether an update is waiting.",
        "operationId": "partner-offers-list",
        "security": [
          {
            "PartnerKey": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000000,
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionsPageResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown, revoked or malformed key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable (the database or a limiter)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/partner/v1/offers/{ref}/end": {
      "post": {
        "tags": [
          "offers"
        ],
        "summary": "End an offer: the sample ran out",
        "description": "Takes effect immediately: the offer's end date becomes now, so the public site and the outbound links already\ntreat it as ended. Ending it again changes nothing.",
        "operationId": "partner-offers-end",
        "security": [
          {
            "PartnerKey": []
          }
        ],
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$",
              "description": "Your own id for the offer: 1 to 64 letters, digits, dots, underscores or hyphens.",
              "title": "Ref"
            },
            "description": "Your own id for the offer: 1 to 64 letters, digits, dots, underscores or hyphens."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EndResultResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown, revoked or malformed key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable (the database or a limiter)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No offer with this ref",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CodedErrorResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "const": false,
            "title": "Success",
            "default": false
          },
          "error": {
            "type": "string",
            "title": "Error"
          },
          "code": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "invalid_url",
                  "link_host_not_allowed",
                  "unknown_category",
                  "invalid_postage",
                  "invalid_window",
                  "empty_text",
                  "subscription_terms_required",
                  "offer_closed",
                  "open_submission_cap",
                  "daily_submission_cap"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "CodedErrorResponse",
        "description": "An error with a fixed message and, for a rule refusal, a stable ``code`` a retailer's software can branch on.\n\nA body that is not the documented shape is a plain 422 with no ``code``."
      },
      "EndResult": {
        "properties": {
          "ref": {
            "type": "string",
            "title": "Ref"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending_review",
              "live",
              "ended",
              "declined"
            ],
            "title": "Status"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "public_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Public Url"
          },
          "update_pending": {
            "type": "boolean",
            "title": "Update Pending"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Submitted At"
          },
          "ends_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ends At"
          },
          "changed": {
            "type": "boolean",
            "title": "Changed"
          }
        },
        "type": "object",
        "required": [
          "ref",
          "status",
          "title",
          "public_url",
          "update_pending",
          "submitted_at",
          "ends_at",
          "changed"
        ],
        "title": "EndResult",
        "description": "The answer to ``end``: ``changed`` is false when the offer had already ended."
      },
      "EndResultResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "const": true,
            "title": "Success",
            "default": true
          },
          "data": {
            "$ref": "#/components/schemas/EndResult"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "EndResultResponse"
      },
      "ErrorResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "const": false,
            "title": "Success",
            "default": false
          },
          "error": {
            "type": "string",
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "description": "Body of every error response (documents the runtime envelope in OpenAPI)."
      },
      "MeData": {
        "properties": {
          "merchant_name": {
            "type": "string",
            "title": "Merchant Name"
          },
          "key_label": {
            "type": "string",
            "title": "Key Label"
          }
        },
        "type": "object",
        "required": [
          "merchant_name",
          "key_label"
        ],
        "title": "MeData"
      },
      "MeResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "const": true,
            "title": "Success",
            "default": true
          },
          "data": {
            "$ref": "#/components/schemas/MeData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "MeResponse"
      },
      "OfferSubmission": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Title"
          },
          "summary": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Summary"
          },
          "description": {
            "items": {
              "type": "string",
              "maxLength": 600,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 5,
            "title": "Description"
          },
          "offer_type": {
            "type": "string",
            "enum": [
              "FREE_SAMPLE",
              "FREE_TRIAL"
            ],
            "title": "Offer Type"
          },
          "category": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "title": "Category"
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Url"
          },
          "postage_kind": {
            "type": "string",
            "enum": [
              "FREE",
              "COST",
              "CHECK_TERMS"
            ],
            "title": "Postage Kind"
          },
          "postage_amount_minor": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Postage Amount Minor"
          },
          "postage_currency": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Postage Currency"
          },
          "requires_card": {
            "type": "boolean",
            "title": "Requires Card"
          },
          "subscription_terms": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 600,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Subscription Terms"
          },
          "eligibility": {
            "type": "string",
            "maxLength": 400,
            "minLength": 1,
            "title": "Eligibility"
          },
          "availability": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Availability"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/StepIn"
            },
            "type": "array",
            "maxItems": 6,
            "title": "Steps"
          },
          "start_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start At"
          },
          "end_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "End At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "summary",
          "offer_type",
          "category",
          "url",
          "postage_kind",
          "requires_card",
          "subscription_terms",
          "eligibility",
          "availability",
          "start_at",
          "end_at"
        ],
        "title": "OfferSubmission",
        "description": "The body of ``PUT /partner/v1/offers/{ref}``: the whole offer, every time (a PUT replaces)."
      },
      "StepIn": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Title"
          },
          "detail": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Detail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "detail"
        ],
        "title": "StepIn"
      },
      "SubmissionResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "const": true,
            "title": "Success",
            "default": true
          },
          "data": {
            "$ref": "#/components/schemas/SubmissionView"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "SubmissionResponse"
      },
      "SubmissionResult": {
        "properties": {
          "ref": {
            "type": "string",
            "title": "Ref"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending_review",
              "live",
              "ended",
              "declined"
            ],
            "title": "Status"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "public_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Public Url"
          },
          "update_pending": {
            "type": "boolean",
            "title": "Update Pending"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Submitted At"
          },
          "ends_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ends At"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "created",
              "refreshed",
              "pending_update",
              "unchanged"
            ],
            "title": "Outcome"
          }
        },
        "type": "object",
        "required": [
          "ref",
          "status",
          "title",
          "public_url",
          "update_pending",
          "submitted_at",
          "ends_at",
          "outcome"
        ],
        "title": "SubmissionResult",
        "description": "The answer to a ``PUT``: what happened to it."
      },
      "SubmissionResultResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "const": true,
            "title": "Success",
            "default": true
          },
          "data": {
            "$ref": "#/components/schemas/SubmissionResult"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "SubmissionResultResponse"
      },
      "SubmissionView": {
        "properties": {
          "ref": {
            "type": "string",
            "title": "Ref"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending_review",
              "live",
              "ended",
              "declined"
            ],
            "title": "Status"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "public_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Public Url"
          },
          "update_pending": {
            "type": "boolean",
            "title": "Update Pending"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Submitted At"
          },
          "ends_at": {
