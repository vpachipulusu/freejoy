{
  "name": "yourapp-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/dev-clean.cjs",
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbo",
    "dev:clean": "node scripts/dev-clean.cjs && npm run dev",
    "dev:kill": "node scripts/dev-kill.cjs",
    "build": "next build --webpack",
    "build:mobile": "next build && npx cap sync",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --dir src/__tests__/unit",
    "test:e2e": "playwright test",
    "test:e2e:local": "node scripts/e2e-local.mjs",
    "test:e2e:go": "playwright test --config=playwright.go.config.ts",
    "test:e2e:saved": "playwright test --config=playwright.saved.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:baseline": "playwright test --config=playwright.baseline.config.ts --project=chromium",
    "test:e2e:build": "node scripts/e2e-build.mjs",
    "test:e2e:baseline:build": "npm run test:e2e:build && npm run test:e2e:baseline",
    "test:e2e:subscription": "playwright test subscription",
    "test:all": "vitest run && playwright test",
    "test:ci": "vitest run --coverage && playwright test",
    "test:setup": "node scripts/setup-e2e-accounts.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "tsc --noEmit",
    "generate:client": "openapi-ts",
    "check:client": "node scripts/check-openapi-client.mjs",
    "cap:init": "npx cap init",
    "cap:sync": "npx cap sync",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:run:ios": "npx cap run ios",
    "cap:run:android": "npx cap run android",
    "cap:update": "npx cap update",
    "ios:build": "npm run build:mobile && npx cap copy ios && npx cap open ios",
    "android:build": "npm run build:mobile && npx cap copy android && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.3",
    "@radix-ui/react-dropdown-menu": "^2.1.3",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.1.3",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.3",
    "@sentry/nextjs": "^10.39.0",
    "@stripe/stripe-js": "^5.0.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-query-devtools": "^5.91.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^11.0.2",
    "lucide-react": "^0.563.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.4",
    "otpauth": "^9.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@hey-api/openapi-ts": "0.95.0",
    "@hookform/resolvers": "^5.9.2",
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.6"
    }
  }
}
