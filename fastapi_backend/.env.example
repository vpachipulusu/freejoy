# Copy to .env and fill in your own values. Every value here is a placeholder.
# Settings are read by app/core/config.py (pydantic-settings); never read os.environ elsewhere.

# Required. asyncpg URL of the platform database. DATABASE_URL_DIRECT (optional) is used by Alembic
# when the runtime URL goes through a pooler.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/yourapp
# DATABASE_URL_DIRECT=

# local | test | production (default). Only local/test (or Vercel preview/development) relax the
# production checks below.
ENVIRONMENT=local

# Testing phase only, remove at go-live (FREEJ-48, ADR-003): set to true to serve /docs, /redoc and the
# OpenAPI schema when ENVIRONMENT is not local/test. Leave unset (false) otherwise. Relaxes nothing else.
# API_DOCS_ENABLED=false

# Partner API (ADR-013): false (the default) means every path under /partner/v1 answers 404. On, a caller needs a
# partner key (issued on the merchant page of the admin). Blank means false; any other value that is not a boolean
# stops startup.
PARTNER_API_ENABLED=false
# The restricted database role the partner surface connects as (ADR-013): the role created by
# commands/sql/partner_role.sql, NOT the owner DATABASE_URL. Required only when PARTNER_API_ENABLED is true (startup
# fails without it, or if it equals DATABASE_URL); leave blank otherwise. Production: end it with ?sslmode=verify-full.
# Placeholder only, never commit a real value.
PARTNER_DATABASE_URL=

# Brand. The frontend reads NEXT_PUBLIC_APP_NAME from its own .env; keep the two in step.
APP_NAME="Freejoy API"
LOG_LEVEL=INFO

# Shared service key the Next.js server sends as X-Internal-Key. Required outside local/test.
# BACKEND_INTERNAL_KEY_NEXT lets you rotate: both keys are accepted while it is set.
BACKEND_INTERNAL_KEY=
# BACKEND_INTERNAL_KEY_NEXT=

# Firebase Admin (ID token and session cookie verification). Required outside local/test.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# FIREBASE_CLOCK_SKEW_SECONDS=10

# Rate limiting (Upstash Redis REST). Required outside local/test; in-memory limiter otherwise.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# HMAC key for hashing e-mail addresses in auth rate-limit keys. Required outside local/test.
RATE_LIMIT_EMAIL_KEY=

# Fernet key that encrypts 2FA (TOTP) secrets at rest. Optional locally, required to enable 2FA.
TOTP_ENCRYPTION_KEY=
# Name shown in the authenticator app next to the account. Keep it equal to NEXT_PUBLIC_APP_NAME.
TOTP_ISSUER="Freejoy"

# Alerts email (ADR-012, docs/developer/backend-subscribers.md). Backend only: the frontend never sees these.
# EMAIL_PROVIDER unset means NOTHING is ever sent (local dev and tests); production then refuses sign-ups.
# brevo = the real provider (needs the next four values). fake = records messages, never sends, and is
# refused outside ENVIRONMENT local/test; EMAIL_FAKE_OUTBOX is a file it appends each message to as JSON.
EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=
# Numeric id of the Brevo list that holds confirmed subscribers.
EMAIL_PROVIDER_LIST_ID=
# Sender address on a domain you have verified with SPF, DKIM and DMARC. EMAIL_FROM_NAME is the display name.
EMAIL_FROM=
EMAIL_FROM_NAME=Freejoy
# EMAIL_FAKE_OUTBOX=
# Public origin of the website (no path): the base of the confirm and unsubscribe links in emails.
PUBLIC_SITE_URL=http://localhost:3000
# HMAC secret (32+ random characters) that signs the confirm and unsubscribe tokens. Required outside local/test.
SUBSCRIBER_TOKEN_SECRET=

# Awin importers: offers (docs/developer/backend-awin-import.md, `uv run python -m commands.import_awin_offers`) and
# network reports (docs/developer/backend-network-reports.md, `uv run python -m commands.import_awin_reports`).
# Optional for the app; both commands exit 2 when either is empty. AWIN_OAUTH_API_TOKEN is your Awin API token
# (Awin account > API credentials): it goes in an Authorization header only, never a URL. Never commit values.
AWIN_PUBLISHER_ID=
AWIN_OAUTH_API_TOKEN=

# Sentry (optional; unset disables it). VERCEL_ENV / VERCEL_GIT_COMMIT_SHA are injected by Vercel.
SENTRY_DSN=

# Stripe Billing module (docs/developer/modules.md). Remove this block with the module.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_YEARLY=
STRIPE_PRICE_ID_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ID_ENTERPRISE_YEARLY=
# Comma-separated origins allowed as Stripe Checkout/Portal return URLs (the frontend's origin).
BILLING_RETURN_URL_ORIGINS=http://localhost:3000
